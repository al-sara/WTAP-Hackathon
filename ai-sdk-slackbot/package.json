{
  "name": "ai-sdk-slack-chatbot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "mkdir -p dist && touch dist/.keep",
    "typecheck": "tsc --noEmit",
    "policy:build": "opa build -t wasm -e agent/call/decision -o policies/bundle.tar.gz policies/decision.rego && tar -xzf policies/bundle.tar.gz -C policies /policy.wasm && rm policies/bundle.tar.gz",
    "policy:test": "opa test policies/",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env scripts/dev-server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/google": "4.0.0-canary.81",
    "@ai-sdk/policy-opa": "1.0.0-canary.1",
    "@ai-sdk/provider-utils": "5.0.0-canary.45",
    "@open-policy-agent/opa": "^2.0.0",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@slack/web-api": "^7.9.3",
    "@vercel/functions": "^2.0.0",
    "ai": "7.0.0-canary.164",
    "ai-sdk-ollama": "^3.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.22.3",
    "typescript": "^5.3.3"
  }
